# --- Zap · local-only duplex companion ---------------------------------
PORT=3000
OLLAMA_URL=http://localhost:11434

# Chat + embedding models (pulled by scripts/setup.sh; keep tiny on low RAM)
ZAP_LLM_MODEL=qwen2.5:0.5b
ZAP_EMBED_MODEL=nomic-embed-text

# STT: faster-whisper sidecar (primary) → whisper.cpp :8080 (alt)
ZAP_STT_URL=http://localhost:8091
ZAP_WHISPER_CPP_URL=http://localhost:8080
ZAP_STT_MODEL=tiny
ZAP_MAX_UTTERANCE_SECS=30

# TTS: Piper voice file (downloaded by scripts/download-voice.sh), espeak fallback
ZAP_PIPER_BIN=piper
ZAP_PIPER_VOICE=./voices/en_US-lessac-medium.onnx
ZAP_ESPEAK_BIN=espeak

# Memory: built-in sqlite verbatim store; set MEMPALACE_BRIDGE_URL=http://localhost:8092
# to use the real `mempalace` package via sidecar/mempalace_bridge.py
ZAP_MEMORY_DB=./data/memory.sqlite
ZAP_MEMORY_TOP_K=4
#MEMPALACE_BRIDGE_URL=http://localhost:8092

ZAP_SYSTEM_PROMPT=You are Zap, a friendly local AI companion. Reply briefly for voice (1-3 sentences unless asked for more). Be warm, direct, and helpful.
